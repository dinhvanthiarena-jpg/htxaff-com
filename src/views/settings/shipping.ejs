<div class="page-header"><h1>Cài đặt</h1></div>
<%- include('../partials/settings-tabs') %>

<% if (saved) { %><div class="badge badge-success" style="margin-bottom:12px; display:inline-block;">Đã lưu thay đổi</div><% } %>

<form class="card" method="POST" action="/settings/shipping" style="max-width:560px;">
  <div class="form-group">
    <label>Đơn vị vận chuyển hỗ trợ</label>
    <% const options = ['Giao Hàng Nhanh', 'Best Express', 'Grab - Hỏa Tốc', 'J&T Express', 'Ahamove - Hỏa Tốc']; %>
    <% options.forEach(opt => { %>
      <label style="display:flex; align-items:center; gap:8px; font-weight:400; margin-bottom:8px;">
        <input type="checkbox" name="methods" value="<%= opt %>" style="width:auto;"
          <%= shop.shippingMethods.includes(opt) ? 'checked' : '' %> />
        <%= opt %>
      </label>
    <% }) %>
  </div>
  <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
</form>
