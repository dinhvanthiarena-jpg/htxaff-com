<div class="page-header"><h1>Cài đặt</h1></div>
<%- include('../partials/settings-tabs') %>

<div class="page-sub" style="margin-bottom:14px;">Quản lý nơi hàng hóa của bạn được lưu trữ, bán và gửi hàng. Bạn đã dùng <%= branches.length + 1 %> trên 8 chi nhánh có sẵn trên gói của bạn.</div>

<div class="card">
  <h3 style="margin-top:0;">Thêm chi nhánh / điểm lấy hàng</h3>
  <form action="/settings/branches" method="POST" style="display:flex; gap:8px; flex-wrap:wrap;">
    <input type="text" name="name" placeholder="Tên chi nhánh" required style="max-width:220px;" />
    <input type="text" name="address" placeholder="Địa chỉ lấy hàng" required style="max-width:360px;" />
    <button class="btn btn-primary btn-sm">Thêm chi nhánh</button>
  </form>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead><tr><th>Tên chi nhánh</th><th>Địa chỉ</th><th></th></tr></thead>
      <tbody>
        <tr>
          <td><strong><%= shop.shopName %> (Mặc định)</strong></td>
          <td><%= shop.address || 'Chưa cập nhật địa chỉ' %></td>
          <td></td>
        </tr>
        <% branches.forEach(b => { %>
          <tr>
            <td><%= b.name %></td>
            <td><%= b.address %></td>
            <td class="text-right">
              <form action="/settings/branches/<%= b.id %>/delete" method="POST" data-confirm="Xóa chi nhánh này?">
                <button class="btn btn-sm btn-danger">Xóa</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
