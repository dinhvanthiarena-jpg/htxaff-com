<div class="page-header"><h1>Cài đặt</h1></div>
<%- include('../partials/settings-tabs') %>

<% if (saved) { %><div class="badge badge-success" style="margin-bottom:12px; display:inline-block;">Đã lưu thay đổi</div><% } %>

<form class="card" method="POST" action="/settings/bank" style="max-width:560px;">
  <div class="form-group">
    <label>Ngân hàng</label>
    <input type="text" name="bankName" value="<%= shop.bank.bankName %>" required />
  </div>
  <div class="form-group">
    <label>Số tài khoản</label>
    <input type="text" name="accountNumber" value="<%= shop.bank.accountNumber %>" required />
  </div>
  <div class="form-group">
    <label>Chủ tài khoản</label>
    <input type="text" name="accountHolder" value="<%= shop.bank.accountHolder %>" required />
  </div>
  <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
</form>
