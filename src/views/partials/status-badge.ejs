  pending_pickup: { cls: 'badge-info', label: 'Chờ lấy hàng' },
  shipping: { cls: 'badge-info', label: 'Đang giao' },
  delivered: { cls: 'badge-success', label: 'Đã giao' },
  cancelled: { cls: 'badge-danger', label: 'Đã hủy' },
  return_refund: { cls: 'badge-danger', label: 'Trả hàng/Hoàn tiền' },
  active: { cls: 'badge-success', label: 'Đang bán' },
  hidden: { cls: 'badge-muted', label: 'Đã ẩn' },
  pending: { cls: 'badge-warning', label: 'Chờ duyệt' },
  running: { cls: 'badge-success', label: 'Đang chạy' },
  scheduled: { cls: 'badge-info', label: 'Đang lên lịch' },
  stopped: { cls: 'badge-muted', label: 'Đã dừng' },
