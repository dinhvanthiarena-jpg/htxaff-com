<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng ký - HTXAFF.com</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="auth-page">
    <div class="auth-topbar">
      <div class="logo-badge">HTX</div>
      <div class="brand-title">htxaff<span style="color:var(--brand)">.com</span></div>
      <div class="divider"></div>
      <div class="page-name">Kênh bán hàng</div>
    </div>

    <div class="auth-body">
      <div class="auth-hero">
        <h1>Đăng bán hoàn toàn miễn phí</h1>
        <p>Hiển thị ngay sản phẩm của bạn đến hơn hàng triệu nhà bán lẻ. Tạo gian hàng chỉ trong vài phút.</p>
      </div>

      <div class="auth-card" style="width:400px;">
        <h2>ĐĂNG KÝ GIAN HÀNG</h2>
        <% if (error) { %>
          <div class="auth-error"><%= error %></div>
        <% } %>
        <form method="POST" action="/register">
          <div class="form-group">
            <label>Tên gian hàng</label>
            <input type="text" name="shopName" placeholder="VD: Nam Phát Wholesale Store" required />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="email@example.com" required />
          </div>
          <div class="form-group">
            <label>Số điện thoại</label>
            <input type="tel" name="phone" placeholder="09xxxxxxxx" required />
          </div>
          <div class="form-group">
            <label>Mật khẩu</label>
            <input type="password" name="password" placeholder="Tối thiểu 6 ký tự" minlength="6" required />
          </div>
          <button type="submit" class="btn btn-primary">ĐĂNG KÝ</button>
        </form>
        <div class="auth-footer">
          Đã có tài khoản? <a href="/login">Đăng nhập →</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
