<div class="page-header"><h1>Yêu cầu báo giá</h1></div>

<div class="card">
  <div class="tabs">
    <a class="tab-item" href="/rfqs">Tất cả yêu cầu</a>
    <a class="tab-item active" href="/rfqs/quotations">Báo giá đã gửi</a>
    <a class="tab-item" href="/rfqs/notifications">Cài đặt nhận thông báo</a>
  </div>

  <div class="table-wrap">
    <table>
      <thead><tr><th>Yêu cầu</th><th>Giá đã báo</th><th>Ghi chú</th><th>Ngày gửi</th></tr></thead>
      <tbody>
        <% if (!quotations.length) { %>
          <tr><td colspan="4"><div class="empty-state"><div class="emoji">📨</div>Bạn chưa gửi báo giá nào</div></td></tr>
        <% } %>
        <% quotations.forEach(q => { %>
          <tr>
            <td><%= q.rfq ? q.rfq.title : '(Yêu cầu đã bị xóa)' %></td>
            <td><%= formatMoney(q.price) %></td>
            <td class="text-muted"><%= q.note || '—' %></td>
            <td class="text-muted"><%= dayjs(q.createdAt).format('DD/MM/YYYY HH:mm') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
