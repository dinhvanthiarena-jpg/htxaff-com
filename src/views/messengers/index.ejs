<div class="page-header"><h1>Tin nhắn</h1></div>

<div class="card" style="padding:0; display:flex; height:560px; overflow:hidden;">
  <div style="width:280px; border-right:1px solid var(--border); overflow-y:auto;">
    <% if (!conversations.length) { %>
      <div class="empty-state"><div class="emoji">💬</div>Chưa có cuộc trò chuyện nào</div>
    <% } %>
    <% conversations.forEach(c => { %>
      <a href="/messengers?c=<%= c.id %>" style="display:block; padding:14px 16px; border-bottom:1px solid var(--border); <%= activeConversation && activeConversation.id===c.id ? 'background:var(--brand-light);' : '' %>">
        <div style="display:flex; justify-content:space-between;">
          <strong style="font-size:13.5px;"><%= c.customerName %></strong>
          <% if (c.unreadForShop) { %><span class="badge-dot" style="position:static;">•</span><% } %>
        </div>
        <div class="text-muted" style="font-size:12px; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
          <%= c.messages[c.messages.length-1].text %>
        </div>
      </a>
    <% }) %>
  </div>

  <div style="flex:1; display:flex; flex-direction:column;">
    <% if (!activeConversation) { %>
      <div class="empty-state" style="margin:auto;"><div class="emoji">💬</div>Chọn một cuộc trò chuyện để xem</div>
    <% } else { %>
      <div style="padding:14px 18px; border-bottom:1px solid var(--border); font-weight:700;">
        <%= activeConversation.customerName %>
      </div>
      <div style="flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:10px;">
        <% activeConversation.messages.forEach(m => { %>
          <div style="max-width:70%; align-self: <%= m.from === 'shop' ? 'flex-end' : 'flex-start' %>;">
            <div style="background: <%= m.from === 'shop' ? 'var(--brand)' : 'var(--bg)' %>; color: <%= m.from === 'shop' ? '#fff' : 'var(--text)' %>; padding:9px 13px; border-radius:12px; font-size:13.5px;">
              <%= m.text %>
            </div>
            <div class="text-muted" style="font-size:11px; margin-top:3px; text-align: <%= m.from === 'shop' ? 'right' : 'left' %>;">
              <%= dayjs(m.at).format('HH:mm DD/MM') %>
            </div>
          </div>
        <% }) %>
      </div>
      <form action="/messengers/<%= activeConversation.id %>/reply" method="POST" style="display:flex; gap:8px; padding:14px; border-top:1px solid var(--border);">
        <input type="text" name="text" placeholder="Nhập tin nhắn..." required style="flex:1;" />
        <button class="btn btn-primary">Gửi</button>
      </form>
    <% } %>
  </div>
</div>
