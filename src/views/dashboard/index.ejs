<% if (typeof denied !== 'undefined' && denied) { %>
  <div class="auth-error" style="margin-bottom:16px;">Tài khoản của bạn không có quyền truy cập mục đó. Liên hệ chủ gian hàng nếu cần mở thêm quyền.</div>
<% } %>

<div class="page-header">
  <div>
    <h1>Trang chủ</h1>
    <div class="page-sub">Xin chào, <%= shop.shopName %> 👋 Đây là tình hình kinh doanh của bạn.</div>
  </div>
  <% if (typeof isOwner === 'undefined' || isOwner || (permissions && permissions.products)) { %>
    <a href="/products/new" class="btn btn-primary">+ Đăng sản phẩm mới</a>
  <% } %>
</div>

<% const canSeeLink = (link) => {
  if (typeof isOwner === 'undefined' || isOwner) return true;
  if (link.startsWith('/messengers')) return permissions && permissions.feed;
  if (link.startsWith('/settings/shipping') || link.startsWith('/settings/general') || link.startsWith('/settings/shop')) return permissions && permissions.settings;
  if (link.startsWith('/promotions')) return permissions && permissions.promotions;
  return true;
}; %>
<% const visibleTodoList = todoList.filter(t => canSeeLink(t.link)); %>

<div class="grid-2" style="margin-bottom:16px;">
  <div class="card">
    <h3 style="margin-top:0;">Danh sách cần làm</h3>
    <div class="page-sub" style="margin-bottom:10px;">Những công việc chưa hoàn tất</div>
    <% if (!visibleTodoList.length) { %>
      <div class="text-muted">🎉 Bạn đã hoàn tất mọi việc cần làm!</div>
    <% } %>
    <% visibleTodoList.forEach(t => { %>
      <a href="<%= t.link %>" class="detail-row" style="display:flex; text-decoration:none;">
        <span class="label" style="color:var(--text);"><%= t.label %></span>
        <span class="badge badge-warning"><%= t.count %></span>
      </a>
    <% }) %>
  </div>

  <div class="card">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h3 style="margin:0;">Gian hàng</h3>
      <span class="badge badge-info">Hạng <%= shopTier.level %></span>
    </div>
    <div class="page-sub" style="margin:6px 0 14px;">Chưa ưu tiên hiển thị sản phẩm</div>

    <div style="margin-bottom:12px;">
      <div class="detail-row" style="border:none; padding:0 0 4px;">
        <span class="label">Lượt xem gian hàng</span>
        <span><%= shopTier.viewCount %>/<%= shopTier.viewQuota %></span>
      </div>
      <div style="height:6px; background:var(--bg); border-radius:4px; overflow:hidden;">
        <div style="height:100%; background:var(--brand); width: <%= Math.min(100, shopTier.viewCount/shopTier.viewQuota*100) %>%;"></div>
      </div>
    </div>

    <div style="margin-bottom:12px;">
      <div class="detail-row" style="border:none; padding:0 0 4px;">
        <span class="label">Sản phẩm</span>
        <span><%= shopTier.productCount %>/<%= shopTier.productQuota %></span>
      </div>
      <div style="height:6px; background:var(--bg); border-radius:4px; overflow:hidden;">
        <div style="height:100%; background:var(--brand); width: <%= Math.min(100, shopTier.productCount/shopTier.productQuota*100) %>%;"></div>
      </div>
    </div>

    <div style="margin-bottom:12px;">
      <div class="detail-row" style="border:none; padding:0 0 4px;">
        <span class="label">Sản phẩm hiển thị trên sàn</span>
        <span><%= shopTier.visibleProductCount %>/<%= shopTier.productQuota %></span>
      </div>
      <div style="height:6px; background:var(--bg); border-radius:4px; overflow:hidden;">
        <div style="height:100%; background:var(--brand); width: <%= Math.min(100, shopTier.visibleProductCount/shopTier.productQuota*100) %>%;"></div>
      </div>
    </div>

    <div>
      <div class="detail-row" style="border:none; padding:0 0 4px;">
        <span class="label">Bài viết Feed hôm nay</span>
        <span><%= shopTier.feedPostedToday %>/<%= shopTier.feedQuota %></span>
      </div>
      <div style="height:6px; background:var(--bg); border-radius:4px; overflow:hidden;">
        <div style="height:100%; background:var(--brand); width: <%= Math.min(100, shopTier.feedPostedToday/shopTier.feedQuota*100) %>%;"></div>
      </div>
    </div>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-label">Doanh thu 30 ngày</div>
    <div class="stat-value accent"><%= formatMoney(stats.totalRevenue30) %></div>
    <div class="stat-hint">Đơn đã hoàn thành</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Đơn chờ xác nhận</div>
    <div class="stat-value"><%= stats.pendingOrders %></div>
    <div class="stat-hint"><a href="/orders?status=pending_confirm">Xem ngay →</a></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Đơn đang xử lý</div>
    <div class="stat-value"><%= stats.processingOrders %></div>
    <div class="stat-hint">Đã xác nhận / đóng gói / đang giao</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Sản phẩm đang bán</div>
    <div class="stat-value"><%= stats.totalProducts %></div>
    <div class="stat-hint"><%= stats.lowStockCount %> sản phẩm sắp hết hàng</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Đánh giá trung bình</div>
    <div class="stat-value">⭐ <%= stats.avgRating %></div>
    <div class="stat-hint"><a href="/reviews">Xem đánh giá →</a></div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <h3 style="margin-top:0;">Doanh thu 7 ngày gần đây</h3>
    <%- include('../partials/line-chart', { chartId: 'dashboard-revenue', series: revenueByDay }) %>
  </div>

  <div class="card">
    <h3 style="margin-top:0;">Sản phẩm bán chạy</h3>
    <% if (!topProducts.length) { %>
      <div class="text-muted">Chưa có dữ liệu bán hàng</div>
    <% } %>
    <% topProducts.forEach((p, idx) => { %>
      <div class="detail-row">
        <span class="label">#<%= idx + 1 %> <%= p.name %></span>
        <strong><%= p.sold %> đã bán</strong>
      </div>
    <% }) %>
  </div>
</div>

<div class="card" style="margin-top:16px;">
  <div class="page-header" style="margin-bottom:12px;">
    <h3 style="margin:0;">Đơn hàng gần đây</h3>
    <a href="/orders" class="btn btn-sm">Xem tất cả</a>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Mã đơn</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th><th>Ngày tạo</th></tr>
      </thead>
      <tbody>
        <% if (!recentOrders.length) { %>
          <tr><td colspan="5" class="text-muted">Chưa có đơn hàng nào</td></tr>
        <% } %>
        <% recentOrders.forEach(o => { %>
          <tr onclick="location.href='/orders/<%= o.id %>'" style="cursor:pointer;">
            <td><strong><%= o.code %></strong></td>
            <td><%= o.customer.name %></td>
            <td><%= formatMoney(o.total) %></td>
            <td><%- include('../partials/status-badge', { status: o.status }) %></td>
            <td class="text-muted"><%= new Date(o.createdAt).toLocaleDateString('vi-VN') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
